{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "1200px", "wideSize": "1360px" },
    "color": {
      "palette": [
        { "slug": "surface",    "color": "#EEF1F5", "name": "Fond" },
        { "slug": "card",       "color": "#FFFFFF", "name": "Carte" },
        { "slug": "ink",        "color": "#111827", "name": "Texte" },
        { "slug": "muted",      "color": "#6B7280", "name": "Texte secondaire" },
        { "slug": "accent",     "color": "#0F766E", "name": "Accent" },
        { "slug": "accent-soft","color": "#CCFBF1", "name": "Accent clair" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "slug": "body", "name": "Body", "fontFamily": "\"Noto Sans Arabic\", \"Manrope\", system-ui, sans-serif" },
        { "slug": "display", "name": "Display", "fontFamily": "\"Manrope\", \"Noto Sans Arabic\", system-ui, sans-serif" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--surface)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "lineHeight": "1.6" },
    "elements": { "link": { "color": { "text": "var(--wp--preset--color--accent)" } } }
  }
}
